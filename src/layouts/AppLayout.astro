---
import "../styles.css";
import { ClientRouter } from "astro:transitions";
import { createCSSRuleFromTheme } from "@fluentui/react-components";
import { win11Themes } from "@/theme/win11";

// FluentProvider 的 token 样式由 React 在客户端注入，SSR 输出固定为深色：
// 浅色用户从首帧到 hydration 完成之间，卡片、按钮等会先用深色 token 渲染再突然翻白。
// 这里在构建期把两套 token 以 html class 作用域静态输出，首帧即与 html.dark 一致。
const themeTokens = [
  createCSSRuleFromTheme("html.dark .fui-FluentProvider", win11Themes.dark),
  createCSSRuleFromTheme("html:not(.dark) .fui-FluentProvider", win11Themes.light)
].join("\n");

interface Props {
  title: string;
  description?: string;
  /** 页面 island 的 griffel 样式（extractFluentStyles 产出），首帧防 FOUC */
  islandStyles?: string;
}

const {
  title,
  description = "ZZZ OneDragon 插件仓库：发现、安装与提交 ZZZOD 插件。",
  islandStyles = ""
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#f3f3f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#202020" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <ClientRouter />
    <style is:inline set:html={themeTokens} />
    <script is:inline>
      (function () {
        var applyTheme = function () {
          try {
            var saved = localStorage.getItem("zzzod-theme");
            var mode =
              saved === "light" || saved === "dark"
                ? saved
                : window.matchMedia("(prefers-color-scheme: light)").matches
                  ? "light"
                  : "dark";
            var root = document.documentElement;
            root.classList.toggle("dark", mode === "dark");
            root.dataset.theme = mode;
            root.style.colorScheme = mode;
          } catch (_) {
            /* 保持服务端默认的深色 */
          }
        };
        applyTheme();
        // ClientRouter 跳换 DOM 后不会重跑 inline script，需自行在换页后恢复主题
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <Fragment set:html={islandStyles} />
  </head>
  <body>
    <slot />
  </body>
</html>
